{
  "name": "@local/dsh-prompt-suggestion",
  "version": "0.1.0",
  "private": true,
  "description": "Predicts the next message as gray ghost text in the composer, with a settings page for prompt and model.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yepyeel/dsh-prompt-suggestion.git"
  },
  "homepage": "https://github.com/yepyeel/dsh-prompt-suggestion#readme",
  "bugs": {
    "url": "https://github.com/yepyeel/dsh-prompt-suggestion/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "autocomplete",
    "suggestion"
  ]
}
