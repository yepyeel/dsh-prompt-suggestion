{
  "name": "@local/dsh-prompt-suggestion",
  "version": "0.1.2",
  "private": true,
  "description": "Predicts the next message as gray ghost text in the composer, with a settings page for prompt and model.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:check && pnpm test:package"
  },
  "exports": {
    ".": "./build/index.js",
    "./client": "./build/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "build/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yepyeel/dsh-prompt-suggestion.git"
  },
  "homepage": "https://github.com/yepyeel/dsh-prompt-suggestion#readme",
  "bugs": {
    "url": "https://github.com/yepyeel/dsh-prompt-suggestion/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "autocomplete",
    "suggestion"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.3",
    "vitest": "4.0.18"
  }
}
